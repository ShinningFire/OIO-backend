# 运行环境: local(默认) | cloud(微信云托管)
RUNTIME_ENV=local

# ====== 本地开发配置 ======

# MySQL 数据库配置 (本地)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=oio

# Redis 配置 (本地登录缓存)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ====== 微信云托管配置 (线上自动注入，无需手动填写) ======
# MYSQL_ADDRESS=10.0.0.1:3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=xxx
# MYSQL_DATABASE=oio

# ====== 通用配置 ======

# 微信小程序配置
WX_APPID=your_appid
WX_SECRET=your_secret

# 大模型API配置 (兼容OpenAI接口格式)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your_api_key
LLM_MODEL=gpt-3.5-turbo

# 微信内容安全审核API (可选, 若不配置则跳过审核)
WX_CONTENT_CHECK=true

# 服务端口
PORT=3000
